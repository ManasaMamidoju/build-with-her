            },
            {
              "name": "html",
              "value": "<p>Hi {{ $json.recipient.fullName.split(' ')[0] }},</p><p>Your Findability Score is <strong>{{ $json.data.total }} out of 100</strong>.</p><p>That puts you in the <strong>{{ $json.data.band }}</strong> band.</p><p>{{ $json.data.bandLine }}</p><p><a href=\"{{ $json.data.resultUrl }}\">View your full result and the three fixes to do first</a></p><p>Manasa<br>Build With Her Media</p>"
            }
