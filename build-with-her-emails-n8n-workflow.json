      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = items[0].json;\nconst signature = item.headers['x-bwh-signature'] || item.headers['X-BWH-Signature'];\nconst rawBody = typeof item.body === 'string' ? item.body : JSON.stringify(item.body);\nconst secret = process.env.N8N_EMAIL_WEBHOOK_SECRET || 'PASTE_N8N_EMAIL_WEBHOOK_SECRET_HERE';\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(rawBody).digest('hex');\nif (signature !== expected) {\n  return [{ json: { valid: false, reason: 'signature mismatch' } }];\n}\nconst payload = JSON.parse(rawBody);\nreturn [{ json: { valid: true, ...payload } }];"
      },
