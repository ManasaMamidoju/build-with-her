        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $node['Webhook — Trigger'].json.body.recipient_phone, type: 'text', text: { body: $json.editor_brief_card } }) }}",
        "options": {}
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "REPLACE_WHATSAPP_CRED_ID",
          "name": "WhatsApp Bearer Token"
        }
      }
    }
